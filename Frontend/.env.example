NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public website / website-admin Supabase project.
# This is separate from KRAVIA Office identity.
NEXT_PUBLIC_SUPABASE_URL=https://your-public-site-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_public_site_publishable_key_here
SUPABASE_SECRET_KEY=your_public_site_server_only_secret_key_here

# KRAVIA Office PostgreSQL/control-plane project.
# Supabase Auth is NOT the Office identity provider. These server-only values are
# used by the trusted Next.js BFF for Office data, authorization profiles and
# private Storage operations after KRAVIA first-party authentication succeeds.
OFFICE_SUPABASE_URL=https://your-office-project.supabase.co
OFFICE_SUPABASE_SECRET_KEY=your_office_server_only_secret_key_here

# Canonical FastAPI KRAVIA Office runtime.
# Browser code never receives this value; same-origin BFF routes call the runtime.
OFFICE_API_ORIGIN=https://your-office-api.example.com

# Signed server-to-server acknowledgement requests from public Contact, Support
# and Trust/Privacy forms to the Office API. Use the exact same 32+ character
# value in the Backend service. Never expose it with a NEXT_PUBLIC_ prefix.
KRAVIA_PUBLIC_INTAKE_WEBHOOK_SECRET=generate_a_separate_strong_server_only_value

# Server-only HMAC key for pseudonymous website privacy-preference records.
# Use a distinct 32+ character value. Without it, optional analytics remain off.
KRAVIA_PUBLIC_CONSENT_HMAC_KEY=generate_a_separate_strong_server_only_value

# Pooled Neon Postgres URL for the isolated website privacy-preference store.
# This is server-only and must use a Neon `-pooler` hostname with
# `sslmode=require`. Apply Database/neon migrations with the direct URL in a
# controlled operator session; never add either URL to source control.
KRAVIA_WEBSITE_CONSENT_DATABASE_URL=postgresql://role:password@your-neon-pooler-host.neon.tech/neondb?sslmode=require

# Local review only. Never enable either value in staging or production.
KRAVIA_ENABLE_LEGAL_LOCAL_PREVIEW=false
KRAVIA_LEGAL_DRAFT_SOURCE_DIR=

# Server-to-server key used only for the one-time Founder bootstrap.
# Use the exact same value in Vercel Production and the Railway Office API.
# Never expose it with a NEXT_PUBLIC_ prefix.
OFFICE_AUTH_BOOTSTRAP_SECRET=generate_a_strong_random_server_only_value


# Authenticator approved employee distribution.
# Leave unset until the APK/Play/TestFlight/App Store build is signed by KRAVIA.
KRAVIA_AUTHENTICATOR_ANDROID_URL=
KRAVIA_AUTHENTICATOR_IOS_URL=

# Preferred dedicated HMAC root for first-party legal print reservations.
# The print API may derive a context-bound key from an existing server root during
# controlled migration, but production should configure this separate 32+ character value.
KRAVIA_LEGAL_PRINT_SIGNING_KEY=generate_a_separate_strong_server_only_value
