NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public website / website-admin Supabase project.
# This is separate from KRAVIA Office identity.
NEXT_PUBLIC_SUPABASE_URL=https://your-public-site-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_public_site_publishable_key_here
SUPABASE_SECRET_KEY=your_public_site_server_only_secret_key_here

# KRAVIA Office PostgreSQL/control-plane project.
# Supabase Auth is NOT the Office identity provider. These server-only values are
# used by the trusted Next.js BFF for Office data, authorization profiles and
# private Storage operations after KRAVIA first-party authentication succeeds.
OFFICE_SUPABASE_URL=https://your-office-project.supabase.co
OFFICE_SUPABASE_SECRET_KEY=your_office_server_only_secret_key_here

# Canonical FastAPI KRAVIA Office runtime.
# Browser code never receives this value; same-origin BFF routes call the runtime.
OFFICE_API_ORIGIN=https://your-office-api.example.com

# Server-to-server key used only for the one-time Founder bootstrap.
# Use the exact same value in Vercel Production and the Railway Office API.
# Never expose it with a NEXT_PUBLIC_ prefix.
OFFICE_AUTH_BOOTSTRAP_SECRET=generate_a_strong_random_server_only_value

# Optional stable company-controlled installation URLs for KRAVIA Authenticator.
# Leave unset until the corresponding signed distribution channel is approved.
KRAVIA_AUTHENTICATOR_ANDROID_URL=
KRAVIA_AUTHENTICATOR_IOS_URL=
