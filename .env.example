NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public website / website-admin Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-public-site-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_public_site_publishable_key_here
SUPABASE_SECRET_KEY=your_public_site_server_only_secret_key_here

# Dedicated KRAVIA Office identity tenant. Keep this separate from the public-site project.
# These are server-only because /office and /finance use a BFF that stores Supabase
# access/refresh tokens in HttpOnly SameSite=Strict cookies.
OFFICE_SUPABASE_URL=https://your-office-project.supabase.co
OFFICE_SUPABASE_PUBLISHABLE_KEY=your_office_publishable_key_here
# Trusted server-only key used for OWNER/ADMIN user invitations, authoritative current-role
# checks, access reviews and MFA recovery. NEVER prefix this with NEXT_PUBLIC_ or expose it to browsers.
OFFICE_SUPABASE_SECRET_KEY=your_office_secret_key_here

# Canonical FastAPI KRAVIA Office runtime. Browser code never receives this value;
# /api/office-runtime/* forwards only allowlisted API paths with the verified AAL2 JWT.
OFFICE_API_ORIGIN=https://your-private-office-runtime.example.com
