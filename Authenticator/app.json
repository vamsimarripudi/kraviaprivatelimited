{
  "expo": {
    "name": "KRAVIA Authenticator",
    "slug": "kravia-authenticator",
    "scheme": "kraviaauth",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kraviaprivatelimited.authenticator",
      "supportsTablet": false,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kraviaprivatelimited.authenticator",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#05251C"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05251C",
          "image": "./assets/brand/splash.jpg",
          "imageWidth": 360,
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KRAVIA Authenticator to scan KRAVIA Office enrollment QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use Face ID to unlock KRAVIA Authenticator."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock KRAVIA Authenticator."
        }
      ]
    ],
    "extra": {
      "mfaIssuer": "KRAVIA Office",
      "networkModel": "OFFLINE_TOTP_ONLY",
      "otpClipboard": "DISABLED",
      "brandAssets": "LOCKED_GENERATED_ARTWORK"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "enabled": false
    },
    "icon": "./assets/brand/icon.png"
  }
}
