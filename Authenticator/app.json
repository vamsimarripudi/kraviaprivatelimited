{
  "expo": {
    "name": "KRAVIA Authenticator",
    "slug": "kravia-authenticator",
    "scheme": "kraviaauth",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kraviaprivatelimited.authenticator",
      "supportsTablet": false,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kraviaprivatelimited.authenticator",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#123D2E"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KRAVIA Authenticator to scan KRAVIA Office enrollment QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use Face ID to unlock KRAVIA Authenticator."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock KRAVIA Authenticator."
        }
      ]
    ],
    "extra": {
      "mfaIssuer": "KRAVIA Office",
      "networkMode": "OFFLINE_ONLY",
      "otpClipboard": "DISABLED"
    },
    "icon": "./assets/icon.png"
  }
}
