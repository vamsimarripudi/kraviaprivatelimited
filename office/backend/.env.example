# KRAVIA Office — environment template
APP_ENV=development
DATABASE_URL=sqlite:///./kravia_office.db

# Corporate master data is controlled configuration. Do not commit legal evidence,
# addresses, director information, shareholder information, bank records, or certificates into source.
KRAVIA_LEGAL_NAME=KRAVIA PRIVATE LIMITED
KRAVIA_CIN=
KRAVIA_REGISTERED_OFFICE=

# Development-only bootstrap auth. Never use bootstrap mode in production.
AUTH_MODE=bootstrap
OFFICE_BOOTSTRAP_KEY=change-me

# Production identity configuration. Required when APP_ENV=production.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=kravia-office
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# OIDC_ROLE_CLAIM=roles
# OIDC_ACTOR_CLAIM=email

# Tax configuration. Production tax-invoice issuance is blocked until both are present/approved.
KRAVIA_GSTIN=
TAX_CONFIG_APPROVED=false
PUBLIC_BASE_URL=http://localhost:8000

# Private document storage. In production replace local disk with approved private object storage/provider adapter.
DOCUMENT_STORAGE_DIR=./runtime/private-vault
MAX_UPLOAD_BYTES=26214400

# Finance & Ownership execution controls.
# disabled = no payment execution, sandbox = simulated provider for E2E testing,
# live = live provider execution. Keep disabled until provider/bank approvals and secrets are configured.
FINANCE_EXECUTION_MODE=disabled

# RazorpayX live payouts. Keep these in a secret manager; never commit real values.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Razorpay webhook verification secret. Keep in a secret manager.
RAZORPAY_WEBHOOK_SECRET=
