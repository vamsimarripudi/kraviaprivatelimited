# KRAVIA Office — environment template
APP_ENV=development
DATABASE_URL=sqlite:///./kravia_office.db
# Optional transaction-scoped PostgreSQL execution role. In production use the
# least-privilege Office backend role even when the provider login is broader.
DATABASE_EXECUTION_ROLE=

# Corporate master data is controlled configuration. Do not commit legal evidence,
# addresses, director information, shareholder information, bank records, or certificates into source.
KRAVIA_LEGAL_NAME=KRAVIA PRIVATE LIMITED
KRAVIA_CIN=
KRAVIA_REGISTERED_OFFICE=

# Development-only bootstrap auth. Never use bootstrap mode in production.
AUTH_MODE=bootstrap
OFFICE_BOOTSTRAP_KEY=change-me

# Production Office identity — KRAVIA first-party authority.
# Generate both secrets from a cryptographically secure source and keep them out of source control.
# OFFICE_AUTH_BOOTSTRAP_SECRET must be the SAME value in the trusted Vercel BFF and Railway API
# until the one-time Founder registration has completed. It is not sent to the browser.
# For production set APP_ENV=production and AUTH_MODE=first_party.
OFFICE_AUTH_SIGNING_SECRET=
OFFICE_AUTH_BOOTSTRAP_SECRET=
OFFICE_AUTH_EMAIL_DOMAIN=kraviaprivatelimited.com
OFFICE_AUTH_ISSUER=kravia-office
OFFICE_AUTH_AUDIENCE=kravia-office-api
OFFICE_REQUIRED_AAL=aal2
OFFICE_AUTH_ACCESS_TTL_SECONDS=1800
OFFICE_AUTH_REFRESH_TTL_SECONDS=604800
OFFICE_AUTH_INVITE_TTL_SECONDS=259200
OFFICE_AUTH_MAX_FAILED_LOGINS=5
OFFICE_AUTH_LOCKOUT_SECONDS=900

# Legacy OIDC settings are retained only as a temporary rollback path during cutover.
# They are not used when AUTH_MODE=first_party.
SUPABASE_AUTH_URL=https://xjtazosozxmudkbxqhjl.supabase.co
SUPABASE_PUBLISHABLE_KEY=
OIDC_ISSUER=https://xjtazosozxmudkbxqhjl.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=https://xjtazosozxmudkbxqhjl.supabase.co/auth/v1/.well-known/jwks.json
OIDC_ROLE_CLAIM=office_roles
OIDC_ACTOR_CLAIM=email
OIDC_REQUIRED_AAL=aal2

# Tax configuration. Production tax-invoice issuance is blocked until both are present/approved.
KRAVIA_GSTIN=
TAX_CONFIG_APPROVED=false

# GST / e-Invoice direct IRP integration (IRIS IRP core APIs).
# Core API credentials are issued by IRIS IRP separately for sandbox/production.
# Leave GST_EINVOICE_ENABLED=false until KRAVIA is legally required/approved to generate IRNs.
GST_IRP_PROVIDER=IRIS
GST_IRP_ENVIRONMENT=sandbox
GST_IRP_BASE_URL=
GST_IRP_CLIENT_ID=
GST_IRP_CLIENT_SECRET=
GST_IRP_USERNAME=
GST_IRP_PASSWORD=
# Provider public key/certificate for RSA/PKCS1 encryption. Prefer a secret-mounted file;
# base64 PEM is supported for platforms without secret files.
GST_IRP_PUBLIC_KEY_FILE=
GST_IRP_PUBLIC_KEY_PEM_B64=
GST_IRP_TIMEOUT_SECONDS=12
GST_EINVOICE_ENABLED=false
# Structured supplier address required by the GST INV-01 schema.
GST_IRP_SELLER_ADDRESS1=
GST_IRP_SELLER_LOCATION=
GST_IRP_SELLER_PIN=
GST_IRP_SELLER_TRADE_NAME=

# IRIS IRP VAS/Data APIs for consented supplier/recipient invoice downloads.
# The exact VAS user auth token is obtained via IRIS Add User or OTP flow and is
# never exposed to the browser. Portal ID is issued separately for sandbox/production.
GST_IRP_VAS_BASE_URL=
GST_IRP_VAS_PORTAL_ID=
GST_IRP_VAS_USER_ID=
GST_IRP_VAS_AUTH_TOKEN=
GST_IRP_VAS_TIMEOUT_SECONDS=20
# Header names are deployment configuration so the adapter can follow the
# provider-issued integration pack without hard-coding secrets or transport names.
GST_IRP_VAS_PORTAL_ID_HEADER=portalid
GST_IRP_VAS_USER_ID_HEADER=user_id
GST_IRP_VAS_AUTH_TOKEN_HEADER=auth-token
GST_IRP_VAS_MAX_DOWNLOAD_BYTES=26214400
# Comma-separated HTTPS hosts allowed for provider result files. Include any
# provider-issued object-storage host only after verifying it with IRIS.
GST_IRP_VAS_DOWNLOAD_HOSTS=

# GST return filing is a separate GSP boundary. Preparation/review works without
# these values; FILED state is accepted only with external ARN/evidence.
GST_GSP_PROVIDER=FYNAMICS
GST_GSP_ENVIRONMENT=sandbox
GST_GSP_BASE_URL=https://staging.fynamics.co.in/api
GST_GSP_CLIENT_ID=
GST_GSP_CLIENT_SECRET=
# GST taxpayer username configured on the GST system / GSP integration.
GST_GSP_USERNAME=
GST_GSP_STATE_CODE=37
# Fynamics requires the end-user IP header for GSTN calls. Configure the stable
# approved egress/user IP used for the GST session; do not trust browser headers.
GST_GSP_IP_USR=
GST_GSP_TIMEOUT_SECONDS=20
# Final EVC filing remains disabled until the provider integration pack for this
# exact schema version has been acceptance-tested with the KRAVIA sandbox account.
GST_GSP_FILING_CONTRACT=
# GSTR-1 header turnover values. Configure from approved statutory working data.
GST_GSTR1_PREV_YEAR_TURNOVER=
GST_GSTR1_CURRENT_YEAR_TURNOVER=

PUBLIC_BASE_URL=http://localhost:8000

# HTTP security / abuse controls.
# Set production host/origin values to the real Office domain only.
OFFICE_ALLOWED_HOSTS=localhost,127.0.0.1
OFFICE_ALLOWED_ORIGINS=http://localhost:8000
OFFICE_MUTATION_RATE_LIMIT=120
OFFICE_RATE_LIMIT_WINDOW_SECONDS=60
# local = per-process development limiter; database = shared cross-replica limiter.
# Production defaults to database and requires shared mode unless explicitly overridden.
OFFICE_RATE_LIMIT_MODE=local
OFFICE_REQUIRE_SHARED_RATE_LIMIT=false

# Private document storage. In production replace local disk with approved private object storage/provider adapter.
DOCUMENT_STORAGE_DIR=./runtime/private-vault
MAX_UPLOAD_BYTES=26214400


# Private object storage + malware scanning.
# SUPABASE_SERVICE_ROLE_KEY is server-only and must never be exposed to browsers.
# Every inbound file is written to office-quarantine, scanned by private ClamAV,
# and only then promoted to its purpose-specific private bucket.
# Railway never receives a Supabase secret/service-role key. The private Edge
# broker mints short-lived signed Storage operations after verifying a KRAVIA
# P-256 signature.
KRAVIA_STORAGE_BROKER_PRIVATE_KEY=
KRAVIA_STORAGE_BROKER_URL=
KRAVIA_STORAGE_BROKER_TIMEOUT_SECONDS=20
KRAVIA_STORAGE_DOWNLOAD_TIMEOUT_SECONDS=45
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_SECONDS=45
KRAVIA_FILE_SCAN_BATCH_SIZE=10

# Finance & Ownership execution controls.
# disabled = no payment execution, sandbox = simulated provider for E2E testing,
# live = live provider execution. Keep disabled until provider/bank approvals and secrets are configured.
FINANCE_EXECUTION_MODE=disabled

# RazorpayX live payouts. Keep these in a secret manager; never commit real values.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Razorpay webhook verification secret. Keep in a secret manager.
RAZORPAY_WEBHOOK_SECRET=

# Google Drive evidence discovery (read-only metadata).
# Point ROOT_FOLDER_ID to the reviewed KRAVIA Office evidence folder.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Preferred production option: path to a secret-mounted Google service-account JSON
# whose client email has read access to the root folder.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Development/temporary alternative; use only a short-lived token from a secret source.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_TIMEOUT_SECONDS=20

# Runtime observability / SLO policy targets.
# Targets are policy configuration only; Office will not claim measured attainment
# until a verified external telemetry source is connected.
KRAVIA_SLO_AVAILABILITY_TARGET_PERCENT=99.9
KRAVIA_SLO_LATENCY_P95_TARGET_MS=1000
KRAVIA_SLO_TELEMETRY_SOURCE=
KRAVIA_OUTBOX_ALERT_THRESHOLD=25
KRAVIA_WORKFLOW_FAILURE_ALERT_THRESHOLD=1

# Background worker controls. Run the worker as a separate service/process.
KRAVIA_WORKER_INTERVAL_SECONDS=60
KRAVIA_WORKER_BATCH_SIZE=100
KRAVIA_WORKER_STALE_AFTER_SECONDS=180
