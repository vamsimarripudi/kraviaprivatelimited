# KRAVIA Office — environment template
APP_ENV=development
DATABASE_URL=sqlite:///./kravia_office.db
# Optional transaction-scoped PostgreSQL execution role. In production use the
# least-privilege Office backend role even when the provider login is broader.
DATABASE_EXECUTION_ROLE=

# Corporate master data is controlled configuration. Do not commit legal evidence,
# addresses, director information, shareholder information, bank records, or certificates into source.
KRAVIA_LEGAL_NAME=KRAVIA PRIVATE LIMITED
KRAVIA_CIN=
KRAVIA_REGISTERED_OFFICE=

# Development-only bootstrap auth. Never use bootstrap mode in production.
AUTH_MODE=bootstrap
OFFICE_BOOTSTRAP_KEY=change-me

# Production identity — dedicated KRAVIA Office Supabase Auth project.
# The publishable key is intentionally deployment configuration rather than source code.
# For production set APP_ENV=production and AUTH_MODE=oidc.
SUPABASE_AUTH_URL=https://xjtazosozxmudkbxqhjl.supabase.co
SUPABASE_PUBLISHABLE_KEY=
OIDC_ISSUER=https://xjtazosozxmudkbxqhjl.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
OIDC_JWKS_URL=https://xjtazosozxmudkbxqhjl.supabase.co/auth/v1/.well-known/jwks.json
OIDC_ROLE_CLAIM=office_roles
OIDC_ACTOR_CLAIM=email
OIDC_REQUIRED_AAL=aal2

# Tax configuration. Production tax-invoice issuance is blocked until both are present/approved.
KRAVIA_GSTIN=
TAX_CONFIG_APPROVED=false
PUBLIC_BASE_URL=http://localhost:8000

# HTTP security / abuse controls.
# Set production host/origin values to the real Office domain only.
OFFICE_ALLOWED_HOSTS=localhost,127.0.0.1
OFFICE_ALLOWED_ORIGINS=http://localhost:8000
OFFICE_MUTATION_RATE_LIMIT=120
OFFICE_RATE_LIMIT_WINDOW_SECONDS=60
# local = per-process development limiter; database = shared cross-replica limiter.
# Production defaults to database and requires shared mode unless explicitly overridden.
OFFICE_RATE_LIMIT_MODE=local
OFFICE_REQUIRE_SHARED_RATE_LIMIT=false

# Private document storage. In production replace local disk with approved private object storage/provider adapter.
DOCUMENT_STORAGE_DIR=./runtime/private-vault
MAX_UPLOAD_BYTES=26214400

# Finance & Ownership execution controls.
# disabled = no payment execution, sandbox = simulated provider for E2E testing,
# live = live provider execution. Keep disabled until provider/bank approvals and secrets are configured.
FINANCE_EXECUTION_MODE=disabled

# RazorpayX live payouts. Keep these in a secret manager; never commit real values.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Razorpay webhook verification secret. Keep in a secret manager.
RAZORPAY_WEBHOOK_SECRET=

# Google Drive evidence discovery (read-only metadata).
# Point ROOT_FOLDER_ID to the reviewed KRAVIA Office evidence folder.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Preferred production option: path to a secret-mounted Google service-account JSON
# whose client email has read access to the root folder.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Development/temporary alternative; use only a short-lived token from a secret source.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_TIMEOUT_SECONDS=20

# Runtime observability / SLO policy targets.
# Targets are policy configuration only; Office will not claim measured attainment
# until a verified external telemetry source is connected.
KRAVIA_SLO_AVAILABILITY_TARGET_PERCENT=99.9
KRAVIA_SLO_LATENCY_P95_TARGET_MS=1000
KRAVIA_SLO_TELEMETRY_SOURCE=
KRAVIA_OUTBOX_ALERT_THRESHOLD=25
KRAVIA_WORKFLOW_FAILURE_ALERT_THRESHOLD=1

# Background worker controls. Run the worker as a separate service/process.
KRAVIA_WORKER_INTERVAL_SECONDS=60
KRAVIA_WORKER_BATCH_SIZE=100
KRAVIA_WORKER_STALE_AFTER_SECONDS=180
