{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KRAVIA Office: Run",
      "type": "shell",
      "command": "python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "KRAVIA Office: Test",
      "type": "shell",
      "command": "python -m pytest backend/tests -q",
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "KRAVIA Office: Quality Gate",
      "type": "shell",
      "command": "python scripts/quality_gate.py",
      "problemMatcher": []
    },
    {
      "label": "KRAVIA Office: Install Backend",
      "type": "shell",
      "command": "python -m pip install -r backend/requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "KRAVIA Office: DB Migrate",
      "type": "shell",
      "command": "alembic upgrade head",
      "problemMatcher": []
    }
  ]
}
